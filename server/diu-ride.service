[Unit]
Description=DIU Ride Backend Service (FastAPI + WebSockets)
After=network.target

[Service]
User=rahat
Group=rahat
WorkingDirectory=/home/rahat/diu_ride/server
ExecStart=/home/rahat/diu_ride_env/bin/uvicorn main:app --host 0.0.0.0 --port 8001 --workers 1
Restart=always
RestartSec=3s
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
